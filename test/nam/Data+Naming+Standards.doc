   <tr>
    <td class=3D"confluenceTd">
     <p><span style=3D"color:#0055cc;">Allowance</span></p></td>
    <td class=3D"confluenceTd">
     <p><span style=3D"color:#0055cc;">ALWNC</span></p></td>
   </tr>
