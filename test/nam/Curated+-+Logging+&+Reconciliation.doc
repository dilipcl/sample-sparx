20-10-19_13-43-19.png" data-base-url=3D"https://confluence.group.net" data-=
linked-resource-content-type=3D"image/png" data-linked-resource-container-i=
d=3D"95301219" data-linked-resource-container-version=3D"11" tabindex=3D"0"=
 alt=3D"" width=3D"468"></span></p>
<p style=3D"margin-left: 30.0px;"><br></p>
<h2 id=3D"CuratedLogging&amp;Reconciliation-Execution"><strong>Execution</s=
trong></h2>
<p>The Logging and Reconciliation Points are executed via Data Factory pipe=
lines.</p>
<p>Examples of the pipelines used by Flow are:</p>
<ul>
 <li><strong>Flow_Load_Curated_Logging_Detail</strong><br><br>
   A pipeline that performs a FOR loop to execute each Logging Point i.e. p=
erforms an INSERT INTO dwh_audit.dwh_logging_detail SELECT &lt;&lt;columns&=
gt;&gt; FROM &lt;&lt;logging point view&gt;&gt;.<br><br><span class=3D"conf=
luence-embedded-file-wrapper confluence-embedded-manual-size"><img class=3D=
"confluence-embedded-image" draggable=3D"false" height=3D"73" src=3D"650009=
f569a60b335f5dd6afa15dc750153ec0d4670be867ac99237da7292ef2" data-image-src=
=3D"/download/attachments/95301219/image2020-10-19_14-37-35.png?version=3D1=
&amp;modificationDate=3D1603114655000&amp;api=3Dv2" data-unresolved-comment=
-count=3D"0" data-linked-resource-id=3D"95301440" data-linked-resource-vers=
ion=3D"1" data-linked-resource-type=3D"attachment" data-linked-resource-def=
ault-alias=3D"image2020-10-19_14-37-35.png" data-base-url=3D"https://conflu=
ence.group.net" data-linked-resource-content-type=3D"image/png" data-linked=
-resource-container-id=3D"95301219" data-linked-resource-container-version=
=3D"11" tabindex=3D"0" alt=3D"" width=3D"468"></span><br><strong><br></stro=
ng></li>
 <li><strong>Flow_Load_Curated_Reconciliation_Detail</strong><br><br>
   A pipeline that performs a FOR loop to execute each Reconciliation Point=
 i.e. performs an INSERT INTO dwh_audit.dwh_reconciliation_point_detail SEL=
ECT &lt;&lt;columns&gt;&gt; FROM dwh_audit.vw_ins_rp_flow_rcncn_point_detai=
l.<br><br><span class=3D"confluence-embedded-file-wrapper confluence-embedd=
ed-manual-size"><img class=3D"confluence-embedded-image" draggable=3D"false=
" height=3D"67" src=3D"55042438556fe41f0ddff4d338a5333c4330f3a390e4f6644e6b=
718b53ea259b" data-image-src=3D"/download/attachments/95301219/image2020-10=
-19_14-48-59.png?version=3D1&amp;modificationDate=3D1603115339000&amp;api=
=3Dv2" data-unresolved-comment-count=3D"0" data-linked-resource-id=3D"95301=
449" data-linked-resource-version=3D"1" data-linked-resource-type=3D"attach=
ment" data-linked-resource-default-alias=3D"image2020-10-19_14-48-59.png" d=
ata-base-url=3D"https://confluence.group.net" data-linked-resource-content-=
type=3D"image/png" data-linked-resource-container-id=3D"95301219" data-link=
ed-resource-container-version=3D"11" tabindex=3D"0" alt=3D"" width=3D"468">=
</span></li>
</ul>
<h2 id=3D"CuratedLogging&amp;Reconciliation-QueryingResults"><strong>Queryi=
ng Results</strong></h2>
<p>An example script that can be used to query the latest Logging (non-zero=
) and Reconciliation results, uses view&nbsp;dwh_audit.VW_LATEST_RCNCN_LOGG=
ING_POINT_RESULT. <br><br>
  The last 7 days of SIRA results (non-zero) are also displayed as SIRA rec=
onciliation is for the last execution only.</p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
 <div class=3D"codeContent panelContent pdl">
  <pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"bru=
sh: java; gutter: false">--************************************************=
*******************************************************************
-- Variables
--*************************************************************************=
******************************************
DECLARE @v_rcncn_exctn_point_name_idw VARCHAR(100)
DECLARE @v_rcncn_exctn_point_name_trnsmtl VARCHAR(100)

SET @v_rcncn_exctn_point_name_idw     =3D 'RCNCN_EXCTN_POINT_POST_IDW'
SET @v_rcncn_exctn_point_name_trnsmtl =3D 'RCNCN_EXCTN_POINT_POST_TRNSMTL'

--*************************************************************************=
******************************************
-- Logging
--*************************************************************************=
******************************************
SELECT *
FROM   dwh_audit.VW_LATEST_RCNCN_LOGGING_POINT_RESULT
WHERE (rcncn_exctn_point_name =3D @v_rcncn_exctn_point_name_idw
   OR  rcncn_exctn_point_name =3D @v_rcncn_exctn_point_name_trnsmtl)
AND logged_cnt &lt;&gt; 0
ORDER BY rcncn_exctn_point_name,rcncn_point_id,logging_point_id

--*************************************************************************=
******************************************
-- Reconciliation
--*************************************************************************=
******************************************
SELECT *
FROM   dwh_audit.vw_latest_rcncn_point_result vlrpr
INNER JOIN (SELECT vlrlpr.rcncn_exctn_point_name
                  ,MAX(vlrlpr.dwh_create_dts) AS latest_logging_dwh_create_=
dts
            FROM   dwh_audit.vw_latest_rcncn_logging_point_result vlrlpr
            GROUP BY rcncn_exctn_point_name) ivlog ON (ivlog.rcncn_exctn_po=
int_name =3D vlrpr.rcncn_exctn_point_name)
WHERE  vlrpr.dwh_create_dts &gt; ivlog.latest_logging_dwh_create_dts
  AND (vlrpr.rcncn_exctn_point_name =3D @v_rcncn_exctn_point_name_idw
   OR  vlrpr.rcncn_exctn_point_name =3D @v_rcncn_exctn_point_name_trnsmtl)
ORDER BY vlrpr.rcncn_exctn_point_name,vlrpr.rcncn_point_id

--*************************************************************************=
******************************************
-- SIRA Errors - Last 7 days
--*************************************************************************=
******************************************
SELECT drpc.rcncn_point_id
      ,drp.active_ind  AS rcncn_point_active_ind
      ,drpc.active_ind AS rcncn_point_control_active_ind
      ,drep.rcncn_exctn_point_name
      ,drp.rcncn_point_name
      ,dld.dwh_create_dts
      ,dlp.logging_point_id
      ,dlp.logging_point_name
      ,dlp.srce_ref
      ,dlp.trgt_schema_name
      ,dld.logged_cnt
      ,dld.dwh_guid AS dwh_guid_logging
FROM   dwh_audit.dwh_logging_point dlp
INNER JOIN dwh_audit.dwh_logging_detail dld       ON (dld.logging_point_id =
     =3D dlp.logging_point_id)
INNER JOIN dwh_audit.dwh_rcncn_point_control drpc ON (drpc.logging_point_id=
     =3D dlp.logging_point_id)
INNER JOIN dwh_audit.dwh_rcncn_point drp          ON (drp.rcncn_point_id   =
     =3D drpc.rcncn_point_id)
INNER JOIN dwh_audit.dwh_rcncn_exctn_point drep   ON (drep.rcncn_exctn_poin=
t_id =3D drp.rcncn_exctn_point_id)
AND    drpc.active_ind    =3D 'Y'
AND    drp.active_ind     =3D 'Y'
AND    drp.rcncn_point_name =3D 'RP_FLOW_TRNSMTL_SIRA'
AND    dld.dwh_create_dts &gt; getdate()-7
AND    dld.logged_cnt &lt;&gt; 0
ORDER BY dld.dwh_create_dts DESC,drpc.rcncn_point_id,dlp.logging_point_id
GO


</pre>
 </div>
</div>
<p><br></p>
<p><br></p>
    </div>
</body>
</html>
