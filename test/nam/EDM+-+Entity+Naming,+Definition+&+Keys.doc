<body>
    <h1>EDM - Entity Naming, Definition &amp; Keys</h1>
    <div class=3D"Section1">
        <p>
 <style type=3D"text/css">/*<![CDATA[*/
div.rbtoc1769443808227 {padding: 0px;}
div.rbtoc1769443808227 ul {margin-left: 0px;}
